# ── Supabase PostgreSQL (transaction pooler, port 6543) ────────────────
# Paste your Supabase pooler connection string here.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Session & Security ──────────────────────────────────────────────────
# Used to sign session tokens (HMAC-SHA256). Change to a random string in production!
SECRET_KEY=change_this_to_a_random_secret_in_production
PORT=3000

# ── AI Provider Configuration ───────────────────────────────────────────
# Active provider: groq, gemini, or openrouter (default: groq)
PROVIDER=groq

# Model name (can be changed to any model supported by your chosen provider)
# For Groq: openai/gpt-oss-120b or openai/gpt-oss-20b
# For Gemini: gemini-2.0-flash
# For OpenRouter: meta-llama/llama-3.3-70b-instruct
MODEL=openai/gpt-oss-120b

# ── API Keys (Server-side only — never exposed to browsers or GitHub) ───
# Groq: free tier at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
