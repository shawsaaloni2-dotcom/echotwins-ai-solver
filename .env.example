# ── Supabase PostgreSQL (transaction pooler, port 6543) ────────────────
# Paste your Supabase pooler connection string here.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Admin password used by the admin panel ─────────────────────────────
ADMIN_SECRET=echotwins_admin_change_me

# ── AI Keys (Server-side Proxy — keys stay 100% hidden from clients & GitHub) ──
# Get your free Groq key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative AI keys
GEMINI_API_KEY=
META_API_KEY=

